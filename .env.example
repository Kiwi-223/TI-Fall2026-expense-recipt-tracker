# Copy this file to .env and edit it. Never commit .env.

# Which OCR provider to use: mock | azure
OCR_PROVIDER=mock

# Where the local SQLite ledger lives
LEDGER_PATH=./ledger.db

# Only needed if OCR_PROVIDER=azure. Use your own free-tier resource; never share keys.
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=
